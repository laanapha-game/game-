# Cloudflare Pages response headers (copied to the site root by `npm run build:site`).
# Hashed build files never change: cache them for a year. Everything else (index.html,
# the icons, the share image) is revalidated so a new deploy shows up at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
