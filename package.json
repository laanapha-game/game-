{
  "name": "lannapha-halloween-scene2",
  "version": "0.1.0",
  "description": "Scene 2 (Trick or Treat run) of the Lannapha Halloween Fest promo game",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "sprites": "node tools/prep-sprites.mjs",
    "build:demo": "vite build --config vite.demo.config.js",
    "check:dialogue": "node tests/e2e/dialogue-check.mjs",
    "scene1": "node tools/scene1-page.mjs && node tools/prep-sprites.mjs scene1 && python3 tools/krahang_combo.py",
    "test:flow": "node tests/e2e/flow.mjs",
    "test:scene3": "node tests/e2e/scene3.mjs",
    "scene3:art": "python3 tools/scene3_art.py --sheet docs/scene3/props_contact_sheet.png"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trerapop/Lannapa-Halloween-Fest.git"
  },
  "bugs": {
    "url": "https://github.com/trerapop/Lannapa-Halloween-Fest/issues"
  },
  "homepage": "https://github.com/trerapop/Lannapa-Halloween-Fest#readme",
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true,
  "type": "module"
}
